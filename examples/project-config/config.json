{
  "defaultPreset": "cinematic-minimal",
  "defaultViewports": [375, 768, 1280],
  "auditStrictness": "normal",
  "designContract": {
    "source": "../design.md",
    "strictness": "prefer",
    "colors": {
      "roles": ["surface", "text", "border", "accent", "success", "warning", "error", "focus"]
    },
    "typography": {
      "roles": ["heading", "copy", "label", "action", "code-data"]
    },
    "spacing": {
      "principle": "preserve element, group, and section hierarchy"
    },
    "shape": {},
    "components": {},
    "motion": {},
    "content": {}
  },
  "visualTokens": {
    "radius": {
      "card": "8px",
      "button": "6px",
      "input": "6px",
      "modal": "10px"
    },
    "avoid": [
      "decorative gradient blobs",
      "excessive bento grids",
      "neon glow",
      "generic AI badges"
    ]
  }
}
